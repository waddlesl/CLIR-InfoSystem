@{
    var adminName = Context.Session.GetString("UserName") ?? "Administrator";
}

<div class="container mt-4 dashboard-font">
    <div class="card border-0 shadow-sm p-3 mb-4 bg-white">
        <form method="get" asp-action="AdminDashboard" class="row g-3 align-items-center">
            <div class="col-md-2">
                <h5 class="fw-bold text-navy mb-0">Library Analytics</h5>
            </div>
            
            <div class="col-md-3">
                <select name="userType" class="form-select border-0 bg-light shadow-none">
                    <option value="All">All Users (Student/Faculty)</option>
                    <option value="Student">Students Only</option>
                    <option value="Faculty">Faculty Only</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="term" class="form-select border-0 bg-light shadow-none">
                    <option value="All">All Terms (1st, 2nd, 3rd)</option>
                    <option value="1st Term">1st Term</option>
                    <option value="2nd Term">2nd Term</option>
                    <option value="3rd Term">3rd Term</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="academicYear" class="form-select border-0 bg-light shadow-none">
                    <option value="2025-2026">AY 2025-2026</option>
                    <option value="2024-2025">AY 2024-2025</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-navy w-100 text-white shadow-sm">Filter</button>
            </div>
        </form>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card p-4 border-0 shadow-sm h-100 border-top-red">
                <h6 class="fw-bold text-muted small">SEAT MONITORING</h6>
                <div class="d-flex justify-content-between mt-3">
                    <h3 class="fw-bold mb-0 text-navy">@ViewBag.TakenSeats <small class="fs-6 text-muted">Taken</small></h3>
                    <h3 class="fw-bold mb-0 text-success">@(ViewBag.TotalSeats - ViewBag.TakenSeats) <small class="fs-6 text-muted">Free</small></h3>
                </div>
                <div class="progress mt-3" style="height: 12px;">
                    <div class="progress-bar bg-navy" style="width: @(ViewBag.TakenSeats)%"></div>
                </div>
                <p class="extra-small text-muted mt-2">Total Capacity: @ViewBag.TotalSeats Seats</p>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card p-4 border-0 shadow-sm h-100">
                <h6 class="fw-bold mb-3">Service Utilization per Term</h6>
                <div style="height: 250px; position: relative;"><canvas id="termChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card p-4 border-0 shadow-sm h-100">
                <h6 class="fw-bold mb-3 text-center">Digital Request (ODDS)</h6>
                <div style="height: 250px; position: relative;"><canvas id="oddsStatusChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card p-4 border-0 shadow-sm h-100">
                <h6 class="fw-bold mb-3">Top Users Activity Leaderboard</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light"><tr><th>Name</th><th>Type</th><th class="text-center">Activity</th></tr></thead>
                        <tbody>
                            @foreach (var user in ViewBag.TopUsers)
                            {
                                <tr><td>@user.Name</td><td><span class="badge bg-light text-dark">@user.Type</span></td><td class="text-center fw-bold">@user.Activity</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="card p-4 border-0 shadow-sm h-100">
                <h6 class="fw-bold mb-3">Utilization by Department</h6>
                <div style="height: 250px; position: relative;"><canvas id="deptChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4 border-0 shadow-sm h-100 text-center bg-navy text-white">
                <h6 class="fw-bold small opacity-75">TOTAL BOOK ACCESSIONS</h6>
                <h1 class="display-3 fw-bold my-3">@ViewBag.TotalBookCopies</h1>
                <p class="small mb-0">Unique records starting with <b>"B-"</b> prefix</p>
                <hr class="opacity-25">
                <small>Updated: @DateTime.Now.ToString("MMM dd, yyyy")</small>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const chartOptions = { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } };

    // 1. Term Chart
    new Chart(document.getElementById('termChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.ServiceChartData.terms)),
            datasets: [
                { label: 'Grammarly', data: @Html.Raw(Json.Serialize(ViewBag.ServiceChartData.grammarly)), backgroundColor: '#1e2953' },
                { label: 'Turnitin', data: @Html.Raw(Json.Serialize(ViewBag.ServiceChartData.turnitin)), backgroundColor: '#ed1e28' },
                { label: 'ODDS', data: @Html.Raw(Json.Serialize(ViewBag.ServiceChartData.odds)), backgroundColor: '#fecb00' }
            ]
        },
        options: chartOptions
    });

    // 2. ODDS Status
    new Chart(document.getElementById('oddsStatusChart'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.OddsStatus.Labels)),
            datasets: [{ data: @Html.Raw(Json.Serialize(ViewBag.OddsStatus.Data)), backgroundColor: ['#fecb00', '#1e2953', '#ed1e28'] }]
        },
        options: chartOptions
    });

    // 3. Dept Chart
        new Chart(document.getElementById('deptChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.DeptLabels)) || [],
            datasets: [{
                label: 'Borrowing Activity',
                data: @Html.Raw(Json.Serialize(ViewBag.DeptCounts)) || [],
                backgroundColor: '#ed1e28'
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: { beginAtZero: true, ticks: { stepSize: 1 } } // Ensures 0 is visible
            }
        }
    });
</script>

<style>
    .text-navy {
        color: #1e2953;
    }

    .bg-navy {
        background-color: #1e2953;
    }

    .btn-navy {
        background-color: #1e2953;
        border: none;
    }

    .border-top-red {
        border-top: 5px solid #ed1e28 !important;
    }

    .extra-small {
        font-size: 0.75rem;
    }

    .dashboard-font {
        font-family: 'Inter', sans-serif;
        background-color: #f8f9fa;
    }
</style>